"""
VERIFICATION STEP 3 — CALENDAR LUCK, on the upgraded strategy
=============================================================
Runs the step-2 strategy ($1,000 premium/month, 0.1bp hedge costs, real
skew on puts) on five entry grids, each starting 4 trading days later,
from your master sheet (A=date, B=spot, C=ATM vol, D=90% vol).

WHICH VARIANT: default is UNHEDGED — it shares the same straddle engine
as every variant, and with no put to cushion crash months it is the
WORST-CASE (upper bound) for start-day sensitivity. To also test whether
the insurance damps calendar luck, add 0.85 (and/or 0.90) to CASES below:
each case gets its own cohort table, and a cross-case spread comparison
prints at the end.

Run:  python verify_step3_calendar.py
Outputs: cohort tables + step3_calendar.png (equity overlay per case)
"""
import os
import numpy as np
import pandas as pd
from scipy.stats import norm
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# ----------------------------------------------------------------------
INPUT_PATH      = "my_data.xlsx"     # <-- your master sheet
CASES           = [None]             # add 0.85 / 0.90 for the bonus question
OFFSETS         = [0, 4, 8, 12, 16]  # trading-day start offsets
RATE            = 0.04
TENOR_DAYS      = 30
MULT            = 100
TARGET_PREMIUM  = 1000.0
HEDGE_COST_BP   = 0.1
# ----------------------------------------------------------------------

def d1(S, K, T, r, iv):
    return (np.log(S / K) + (r + 0.5 * iv**2) * T) / (iv * np.sqrt(T))
def bs_put(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a)
def put_delta(S, K, T, r, iv):
    return norm.cdf(d1(S, K, T, r, iv)) - 1.0
def straddle_price(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return (S * norm.cdf(a) - K * np.exp(-r * T) * norm.cdf(b)
            + K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a))
def straddle_delta(S, K, T, r, iv):
    return 2.0 * norm.cdf(d1(S, K, T, r, iv)) - 1.0

ext = os.path.splitext(INPUT_PATH)[1].lower()
raw = (pd.read_excel(INPUT_PATH) if ext in (".xlsx", ".xls")
       else pd.read_csv(INPUT_PATH)).iloc[:, :4]
raw.columns = ["date", "spot", "iv_atm", "iv90"]
raw["date"] = pd.to_datetime(raw["date"])
for c in ["spot", "iv_atm", "iv90"]:
    raw[c] = pd.to_numeric(raw[c], errors="coerce")
base = (raw.dropna().loc[lambda d: d["date"].dt.dayofweek < 5]
           .drop_duplicates(subset="date").sort_values("date").reset_index(drop=True))
if base["iv_atm"].median() > 3:
    base[["iv_atm", "iv90"]] = base[["iv_atm", "iv90"]] / 100.0
base["slope"] = ((base["iv90"] - base["iv_atm"]).clip(lower=0)) / 0.10

def vol_at(S, K, iv_atm, slope):
    return iv_atm + slope * max(0.0, 1.0 - K / S)

def run(df, put_pct):
    cash, shares, pos, anchor = 0.0, 0, None, 0.0
    trade_rows, eq_rows = [], []
    for _, row in df.iterrows():
        today, S = row["date"], row["spot"]
        iv_t, slope_t = row["iv_atm"], row["slope"]
        if pos is not None and today >= pos["expiry"]:
            q = pos["qty"]
            cash -= q * MULT * abs(S - pos["K"])
            if pos["Kp"] is not None:
                cash += q * MULT * max(pos["Kp"] - S, 0.0)
            trade_rows.append({"trade_pnl": (cash + shares * S) - anchor})
            pos = None
        if pos is None:
            anchor = cash + shares * S
            K, T0 = S, TENOR_DAYS / 365.0
            qty = TARGET_PREMIUM / (straddle_price(S, K, T0, RATE, iv_t) * MULT)
            cash += TARGET_PREMIUM
            Kp = None
            if put_pct is not None:
                Kp = S * put_pct
                cash -= qty * MULT * bs_put(S, Kp, T0, RATE, vol_at(S, Kp, iv_t, slope_t))
            pos = {"K": K, "Kp": Kp, "qty": qty,
                   "expiry": today + pd.Timedelta(days=TENOR_DAYS)}
        T = max((pos["expiry"] - today).days / 365.0, 1.0 / 365.0)
        net = straddle_delta(S, pos["K"], T, RATE, iv_t)
        if pos["Kp"] is not None:
            net -= put_delta(S, pos["Kp"], T, RATE, vol_at(S, pos["Kp"], iv_t, slope_t))
        target = round(pos["qty"] * MULT * net)
        trade = target - shares
        cash -= trade * S + abs(trade) * S * HEDGE_COST_BP * 1e-4
        shares = target
        q = pos["qty"]
        liab = q * MULT * straddle_price(S, pos["K"], T, RATE, iv_t)
        pv = (q * MULT * bs_put(S, pos["Kp"], T, RATE, vol_at(S, pos["Kp"], iv_t, slope_t))
              if pos["Kp"] is not None else 0.0)
        eq_rows.append({"date": today, "equity": cash + shares * S - liab + pv})
    return pd.DataFrame(trade_rows), pd.DataFrame(eq_rows).set_index("date")["equity"]

def caselabel(p): return "unhedged" if p is None else f"put@{int(p*100)} (skewed)"

COHORT_COLORS = ["#0b0b0b", "#2a78d6", "#1baf7a", "#eda100", "#e87ba4"]
spreads = {}
fig, axes = plt.subplots(len(CASES), 1, figsize=(11, 4.8 * len(CASES)), squeeze=False)

for ci, p in enumerate(CASES):
    name = caselabel(p)
    print(f"\n================ CALENDAR LUCK: {name} ================")
    res = {}
    for off in OFFSETS:
        trades, eq = run(base.iloc[off:].reset_index(drop=True), p)
        res[off] = (trades, eq)
        print(f"  ran cohort +{off:>2d} (first entry {base['date'].iloc[off].date()}, "
              f"{len(trades)} trades)")
    hdr = [f"+{o}d" + (" (yours)" if o == 0 else "") for o in OFFSETS]
    print(f"{'':22s}" + "".join(f"{h:>14s}" for h in hdr))
    def rowp(lbl, fn, fmt="{:>14,.0f}"):
        print(f"{lbl:22s}" + "".join(fmt.format(fn(*res[o])) for o in OFFSETS))
    rowp("Total P&L ($)",     lambda t, e: e.iloc[-1])
    rowp("Avg trade P&L ($)", lambda t, e: t["trade_pnl"].mean())
    rowp("Win rate",          lambda t, e: (t["trade_pnl"] > 0).mean(), "{:>14.1%}")
    rowp("Worst trade ($)",   lambda t, e: t["trade_pnl"].min())
    rowp("Max drawdown ($)",  lambda t, e: (e - e.cummax()).min())
    rowp("Sharpe (~ann.)",    lambda t, e: t["trade_pnl"].mean()/t["trade_pnl"].std()*np.sqrt(12), "{:>14.2f}")
    totals = np.array([res[o][1].iloc[-1] for o in OFFSETS])
    spread = totals.max() - totals.min()
    spreads[name] = (spread, spread / abs(totals.mean()))
    print(f"  Spread: ${totals.min():,.0f} to ${totals.max():,.0f} "
          f"(range ${spread:,.0f} = {spread/abs(totals.mean()):.0%} of mean). "
          f"Your +0d run ranks {sorted(totals, reverse=True).index(totals[0]) + 1} of {len(totals)}.")

    ax = axes[ci, 0]
    for (off, (_, eq)), c in zip(res.items(), COHORT_COLORS):
        ax.plot(eq.index, eq.values, lw=2.0 if off == 0 else 1.0, color=c,
                label=f"+{off}d" + (" (your run)" if off == 0 else ""))
    ax.axhline(0, color="#c3c2b7", lw=0.7)
    ax.set_title(f"{name} — five start days, same strategy (equity, \\$)",
                 fontsize=11.5, loc="left")
    ax.legend(frameon=False, fontsize=9)
    ax.grid(alpha=0.3, lw=0.5)
    ax.spines[["top", "right"]].set_visible(False)

if len(CASES) > 1:
    print("\n===== DOES THE HEDGE DAMP CALENDAR LUCK? =====")
    for name, (s, pct) in spreads.items():
        print(f"  {name:22s} spread ${s:>8,.0f}  ({pct:.0%} of mean)")

fig.tight_layout()
fig.savefig("step3_calendar.png", dpi=170)
print("\nSaved: step3_calendar.png")
