"""
VERIFICATION STEP 1 — CHARTS (same vibe as the originals, from your master sheet)
=================================================================================
Self-contained: re-runs the flat-vol backtest internally from INPUT_PATH
(same logic as verify_step1_flat.py), then draws the four presentation charts.

Filenames match the deck's placeholders exactly, so you can swap them in
directly (right-click the sample image -> Change Picture):

  put_hedge_comparison.png  — equity curves + drawdown, all five variants
  pnl_histogram.png         — distribution of monthly P&Ls   (deck slide 5)
  iv_vs_realized.png        — implied vs realized vol         (deck slide 4)
  crash_zoom.png            — inside the two worst months     (deck slide 8)

Run:  python verify_step1_charts.py
"""
import os
import numpy as np
import pandas as pd
from scipy.stats import norm
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# ----------------------------------------------------------------------
INPUT_PATH  = "my_data.xlsx"     # <-- same master sheet as verify_step1_flat.py
RATE        = 0.04
TENOR_DAYS  = 30
MULT        = 100
PUT_PCTS    = [None, 0.90, 0.85, 0.80, 0.75]
# ----------------------------------------------------------------------

BLUE, ORANGE, RED = "#2a78d6", "#eb6834", "#e34948"
GRAY, GRID, INK = "#898781", "#e1e0d9", "#0b0b0b"
COLORS = {"unhedged": "#8a8a8a", "put@90pct": "#4a3aa7", "put@85pct": "#2f6db3",
          "put@80pct": "#2f9e6e", "put@75pct": "#b3532f"}

def style(ax):
    ax.grid(alpha=0.55, lw=0.5, color=GRID)
    ax.spines[["top", "right"]].set_visible(False)
    ax.spines[["left", "bottom"]].set_color("#c3c2b7")
    ax.tick_params(colors=GRAY, labelsize=9)

def d1(S, K, T, r, iv):
    return (np.log(S / K) + (r + 0.5 * iv**2) * T) / (iv * np.sqrt(T))
def bs_put(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a)
def put_delta(S, K, T, r, iv):
    return norm.cdf(d1(S, K, T, r, iv)) - 1.0
def straddle_price(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return (S * norm.cdf(a) - K * np.exp(-r * T) * norm.cdf(b)
            + K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a))
def straddle_delta(S, K, T, r, iv):
    return 2.0 * norm.cdf(d1(S, K, T, r, iv)) - 1.0

ext = os.path.splitext(INPUT_PATH)[1].lower()
raw = (pd.read_excel(INPUT_PATH) if ext in (".xlsx", ".xls")
       else pd.read_csv(INPUT_PATH)).iloc[:, :3]
raw.columns = ["date", "spot", "iv"]
raw["date"] = pd.to_datetime(raw["date"])
raw["spot"] = pd.to_numeric(raw["spot"], errors="coerce")
raw["iv"]   = pd.to_numeric(raw["iv"],   errors="coerce")
df = (raw.dropna().loc[lambda d: d["date"].dt.dayofweek < 5]
         .drop_duplicates(subset="date").sort_values("date").reset_index(drop=True))
if df["iv"].median() > 3:
    df["iv"] = df["iv"] / 100.0

def run(df, put_pct):
    cash, shares, pos, anchor = 0.0, 0, None, 0.0
    trade_rows, eq_rows = [], []
    for _, row in df.iterrows():
        today, S, iv = row["date"], row["spot"], row["iv"]
        if pos is not None and today >= pos["expiry"]:
            cash -= MULT * abs(S - pos["K"])
            if pos["Kp"] is not None:
                cash += MULT * max(pos["Kp"] - S, 0.0)
            trade_rows.append({"entry_date": pos["entry_date"],
                               "expiry_date": today, "entry_iv": pos["iv0"],
                               "trade_pnl": (cash + shares * S) - anchor})
            pos = None
        if pos is None:
            anchor = cash + shares * S
            K, T0 = S, TENOR_DAYS / 365.0
            cash += MULT * straddle_price(S, K, T0, RATE, iv)
            Kp = None
            if put_pct is not None:
                Kp = S * put_pct
                cash -= MULT * bs_put(S, Kp, T0, RATE, iv)
            pos = {"entry_date": today, "K": K, "Kp": Kp, "iv0": iv,
                   "expiry": today + pd.Timedelta(days=TENOR_DAYS)}
        T = max((pos["expiry"] - today).days / 365.0, 1.0 / 365.0)
        net = straddle_delta(S, pos["K"], T, RATE, iv)
        if pos["Kp"] is not None:
            net -= put_delta(S, pos["Kp"], T, RATE, iv)
        target = round(MULT * net)
        cash -= (target - shares) * S
        shares = target
        liab = MULT * straddle_price(S, pos["K"], T, RATE, iv)
        pv = MULT * bs_put(S, pos["Kp"], T, RATE, iv) if pos["Kp"] is not None else 0.0
        eq_rows.append({"date": today, "equity": cash + shares * S - liab + pv})
    return (pd.DataFrame(trade_rows),
            pd.DataFrame(eq_rows).set_index("date")["equity"])

def label(p): return "unhedged" if p is None else f"put@{int(p*100)}pct"
R = {label(p): run(df, p) for p in PUT_PCTS}
print("backtests re-run:", ", ".join(R))

# ======================================================================
# CHART 1 — EQUITY + DRAWDOWN, ALL VARIANTS
# ======================================================================
fig, (a1, a2) = plt.subplots(2, 1, figsize=(11, 8), sharex=True,
                             gridspec_kw={"height_ratios": [3, 1]})
for name, (_, eq) in R.items():
    a1.plot(eq.index, eq.values, lw=1.4, color=COLORS[name], label=name, alpha=0.9)
    dd = eq - eq.cummax()
    a2.plot(dd.index, dd.values, lw=1.0, color=COLORS[name], alpha=0.9)
a1.axhline(0, color="#999999", lw=0.7)
a1.set_title("Short 30-Day SPY Straddle, Delta-Hedged, With/Without Crash Puts — Equity (\\$)",
             fontsize=11, loc="left", color=INK)
a1.legend(frameon=False, fontsize=9)
a2.set_title("Drawdown from peak (\\$)", fontsize=10, loc="left", color=INK)
for a in (a1, a2): style(a)
fig.tight_layout()
fig.savefig("put_hedge_comparison.png", dpi=150)
print("saved put_hedge_comparison.png")

# ======================================================================
# CHART 2 — P&L HISTOGRAM (unhedged)
# ======================================================================
trades_u, _ = R["unhedged"]
pnl = trades_u["trade_pnl"]
fig, ax = plt.subplots(figsize=(8, 4.8))
counts, bins, patches = ax.hist(pnl, bins=40, edgecolor="white", lw=0.6)
for patch, left in zip(patches, bins[:-1]):
    patch.set_facecolor(BLUE if left >= 0 else RED)
ax.axvline(0, color="#c3c2b7", lw=0.8)
ax.axvline(pnl.mean(), color=INK, lw=1.2, ls="--")
ax.annotate(f"avg  ${pnl.mean():,.0f}/trade", xy=(pnl.mean(), ax.get_ylim()[1]*0.92),
            xytext=(10, 0), textcoords="offset points", fontsize=10, color=INK)
ax.annotate(f"worst  ${pnl.min():,.0f}", xy=(pnl.min(), 1.5), xytext=(0, 28),
            textcoords="offset points", fontsize=10, color=RED, ha="left",
            arrowprops=dict(arrowstyle="-", color=RED, lw=0.8))
ax.set_title(f"The personality of short volatility — {len(pnl)} monthly trades, "
             f"{(pnl > 0).mean():.0%} winners", fontsize=12, loc="left", color=INK)
ax.set_xlabel("Trade P&L (\\$, per 1 straddle)", fontsize=10, color=GRAY)
ax.set_ylabel("Number of months", fontsize=10, color=GRAY)
ax.yaxis.set_major_locator(plt.MaxNLocator(integer=True))
style(ax)
fig.tight_layout()
fig.savefig("pnl_histogram.png", dpi=180)
print("saved pnl_histogram.png")

# ======================================================================
# CHART 3 — IMPLIED VS REALIZED VOL
# ======================================================================
spy = df.set_index("date")
spy["logret"] = np.log(spy["spot"]).diff()
def realized_vol(a, b):
    r = spy.loc[a:b, "logret"].dropna()
    return r.std() * np.sqrt(252) if len(r) >= 5 else np.nan
t = trades_u.copy()
t["realized"] = [realized_vol(a, b) for a, b in zip(t["entry_date"], t["expiry_date"])]
t = t.dropna(subset=["realized"])
gap = t["entry_iv"] - t["realized"]
fig, ax = plt.subplots(figsize=(9, 4.8))
ax.plot(t["entry_date"], t["entry_iv"]*100, color=BLUE, lw=1.5, label="Implied vol at entry")
ax.plot(t["entry_date"], t["realized"]*100, color=ORANGE, lw=1.5, alpha=0.9,
        label="Realized vol during the trade")
ax.fill_between(t["entry_date"], t["entry_iv"]*100, t["realized"]*100,
                where=t["entry_iv"] > t["realized"], color=BLUE, alpha=0.12, lw=0)
ax.set_title(f"The edge, made visible — implied exceeded realized in "
             f"{(gap > 0).mean():.0%} of months (avg gap {gap.mean()*100:.1f} vol pts)",
             fontsize=12, loc="left", color=INK)
ax.set_ylabel("Volatility (%, annualized)", fontsize=10, color=GRAY)
ax.legend(frameon=False, fontsize=10, loc="upper left")
style(ax)
fig.tight_layout()
fig.savefig("iv_vs_realized.png", dpi=180)
print("saved iv_vs_realized.png")

# ======================================================================
# CHART 4 — INSIDE THE TWO WORST MONTHS (unhedged vs 90% vs 85%)
# ======================================================================
worst2 = trades_u.nsmallest(2, "trade_pnl").sort_values("entry_date")
fig, axes = plt.subplots(2, 2, figsize=(10, 5.6), sharex="col",
                         gridspec_kw={"height_ratios": [1, 1.4]})
for col, (_, tr) in enumerate(worst2.iterrows()):
    a, b = tr["entry_date"] - pd.Timedelta(days=15), tr["expiry_date"] + pd.Timedelta(days=20)
    s = spy.loc[a:b, "spot"]
    ax_s, ax_e = axes[0, col], axes[1, col]
    ax_s.plot(s.index, s.values, color=INK, lw=1.3)
    ax_s.axvspan(tr["entry_date"], tr["expiry_date"], color=RED, alpha=0.06, lw=0)
    ax_s.set_title(f"{tr['entry_date']:%b %Y} — trade lost ${-tr['trade_pnl']:,.0f}",
                   fontsize=11, loc="left", color=INK)
    for name, lab in [("unhedged", "Unhedged"), ("put@90pct", "With 90% put"),
                      ("put@85pct", "With 85% put")]:
        _, eq = R[name]
        e = eq.loc[a:b]; e = e - e.iloc[0]
        ax_e.plot(e.index, e.values, color=COLORS[name], lw=1.5, label=lab)
    ax_e.axhline(0, color="#c3c2b7", lw=0.7)
    for ax in (ax_s, ax_e):
        style(ax)
        ax.tick_params(axis="x", rotation=30)
    if col == 0:
        ax_s.set_ylabel("SPY", fontsize=10, color=GRAY)
        ax_e.set_ylabel("Equity change (\\$)", fontsize=10, color=GRAY)
        ax_e.legend(frameon=False, fontsize=9, loc="lower left")
fig.suptitle("Inside the two worst months — what the crash puts actually did",
             fontsize=12, x=0.01, ha="left", color=INK)
fig.tight_layout(rect=[0, 0, 1, 0.96])
fig.savefig("crash_zoom.png", dpi=180)
print("saved crash_zoom.png")
