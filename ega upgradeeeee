"""
VERIFICATION STEP 2 — THE UPGRADED STRATEGY, from your master sheet
===================================================================
Reads the same ONE Excel file as step 1:
    A = date, B = spot, C = 100%-moneyness (ATM) vol, D = 90%-moneyness vol

THE THREE UPGRADES
  1. HEDGE COSTS: every daily re-hedge pays 0.1bp of the notional traded.
  2. CONSTANT SIZING: each month sells exactly $1,000 of straddle premium
     (fractional contracts), so early years weigh the same as late years.
  3. REAL SKEW: puts are no longer priced at ATM vol.
       - the 90% put uses column D directly (a real market vol),
       - the 85% put uses the linear extension of the 90-100 chord:
             iv85 = iv90 + 0.5 x (iv90 - iv100)
         (same formula as your Excel column),
       - daily marks and deltas interpolate each day's chord to the put's
         CURRENT moneyness (sticky-moneyness), so as SPY falls toward the
         strike the put's vol slides down the smirk.
     The straddle itself stays at ATM vol — it lives at the ATM point.

CASES RUN:  unhedged  |  put@85 (skewed)  |  put@90 (skewed)

OUTPUTS
  - printed table: P&L stats + SHARPE, SORTINO, CALMAR for all three
  - step2_insurance.png : the monthly insurance bill for both hedges,
                          plus cumulative spend (unhedged = zero by definition)
  - step2_equity.png    : cumulative P&L curves + drawdown, all three cases
  - step2_trades_*.csv  : trade ledgers

Ratio definitions (monthly trade P&L, ~12 trades/yr; dollar-based):
  Sharpe  = mean / std x sqrt(12)
  Sortino = mean / std-of-losing-months x sqrt(12)
  Calmar  = annualized P&L ($/yr) / |max drawdown ($)|

Run:  python verify_step2_upgraded.py
"""
import os
import numpy as np
import pandas as pd
from scipy.stats import norm
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

# ----------------------------------------------------------------------
INPUT_PATH      = "my_data.xlsx"   # <-- your master sheet
RATE            = 0.04
TENOR_DAYS      = 30
MULT            = 100
TARGET_PREMIUM  = 1000.0           # $ of straddle premium sold per month
HEDGE_COST_BP   = 0.1              # bp of notional per re-hedge
CASES           = [None, 0.85, 0.90]
# ----------------------------------------------------------------------

BLUE, ORANGE, VIOLET, RED = "#2a78d6", "#eb6834", "#4a3aa7", "#e34948"
GRAY, GRID, INK = "#898781", "#e1e0d9", "#0b0b0b"
COLORS = {"unhedged": "#8a8a8a", "put@85 (skewed)": BLUE, "put@90 (skewed)": VIOLET}

def style(ax):
    ax.grid(alpha=0.55, lw=0.5, color=GRID)
    ax.spines[["top", "right"]].set_visible(False)
    ax.spines[["left", "bottom"]].set_color("#c3c2b7")
    ax.tick_params(colors=GRAY, labelsize=9)

def d1(S, K, T, r, iv):
    return (np.log(S / K) + (r + 0.5 * iv**2) * T) / (iv * np.sqrt(T))
def bs_put(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a)
def put_delta(S, K, T, r, iv):
    return norm.cdf(d1(S, K, T, r, iv)) - 1.0
def straddle_price(S, K, T, r, iv):
    a = d1(S, K, T, r, iv); b = a - iv * np.sqrt(T)
    return (S * norm.cdf(a) - K * np.exp(-r * T) * norm.cdf(b)
            + K * np.exp(-r * T) * norm.cdf(-b) - S * norm.cdf(-a))
def straddle_delta(S, K, T, r, iv):
    return 2.0 * norm.cdf(d1(S, K, T, r, iv)) - 1.0

# ---- load the 4-column master sheet -----------------------------------
ext = os.path.splitext(INPUT_PATH)[1].lower()
raw = (pd.read_excel(INPUT_PATH) if ext in (".xlsx", ".xls")
       else pd.read_csv(INPUT_PATH)).iloc[:, :4]
raw.columns = ["date", "spot", "iv_atm", "iv90"]
raw["date"] = pd.to_datetime(raw["date"])
for c in ["spot", "iv_atm", "iv90"]:
    raw[c] = pd.to_numeric(raw[c], errors="coerce")
df = (raw.dropna().loc[lambda d: d["date"].dt.dayofweek < 5]
         .drop_duplicates(subset="date").sort_values("date").reset_index(drop=True))
if df["iv_atm"].median() > 3:
    df[["iv_atm", "iv90"]] = df[["iv_atm", "iv90"]] / 100.0
    print("Detected percent units — divided vol columns by 100.")

# the day's skew: 90-over-100 premium (floored at 0), slope per 1% OTM
df["prem90"] = (df["iv90"] - df["iv_atm"]).clip(lower=0)      # decimal
df["slope"]  = df["prem90"] / 0.10                            # per 1.00 of moneyness
print(f"Loaded {len(df)} days: {df.date.iloc[0].date()} to {df.date.iloc[-1].date()}")
print(f"90%-over-ATM premium: median {df['prem90'].median()*100:.1f} vol pts | "
      f"implied 85% premium: median {df['prem90'].median()*1.5*100:.1f} vol pts")

def vol_at(S, K, iv_atm, slope):
    """Skewed vol for strike K today: ATM + slope x current %OTM (sticky moneyness)."""
    return iv_atm + slope * max(0.0, 1.0 - K / S)

def run(df, put_pct):
    cash, shares, pos, anchor = 0.0, 0, None, 0.0
    trade_rows, eq_rows = [], []
    for _, row in df.iterrows():
        today, S = row["date"], row["spot"]
        iv_t, slope_t = row["iv_atm"], row["slope"]

        if pos is not None and today >= pos["expiry"]:
            q = pos["qty"]
            cash -= q * MULT * abs(S - pos["K"])
            put_payout = 0.0
            if pos["Kp"] is not None:
                put_payout = q * MULT * max(pos["Kp"] - S, 0.0)
                cash += put_payout
            trade_rows.append({"entry_date": pos["entry_date"], "qty": q,
                               "premium": pos["premium"], "put_cost": pos["put_cost"],
                               "put_payout": put_payout, "hedge_costs": pos["hcost"],
                               "trade_pnl": (cash + shares * S) - anchor})
            pos = None

        if pos is None:
            anchor = cash + shares * S
            K, T0 = S, TENOR_DAYS / 365.0
            px = straddle_price(S, K, T0, RATE, iv_t)
            qty = TARGET_PREMIUM / (px * MULT)                 # $1,000 of premium
            cash += TARGET_PREMIUM
            Kp, put_cost = None, 0.0
            if put_pct is not None:
                Kp = S * put_pct
                ivp = vol_at(S, Kp, iv_t, slope_t)             # skewed entry vol
                put_cost = qty * MULT * bs_put(S, Kp, T0, RATE, ivp)
                cash -= put_cost
            pos = {"entry_date": today, "K": K, "Kp": Kp, "qty": qty,
                   "expiry": today + pd.Timedelta(days=TENOR_DAYS),
                   "premium": TARGET_PREMIUM, "put_cost": put_cost, "hcost": 0.0}

        T = max((pos["expiry"] - today).days / 365.0, 1.0 / 365.0)
        net = straddle_delta(S, pos["K"], T, RATE, iv_t)
        if pos["Kp"] is not None:
            net -= put_delta(S, pos["Kp"], T, RATE, vol_at(S, pos["Kp"], iv_t, slope_t))
        target = round(pos["qty"] * MULT * net)
        trade = target - shares
        cost = abs(trade) * S * HEDGE_COST_BP * 1e-4           # 0.1bp of notional
        cash -= trade * S + cost
        pos["hcost"] += cost
        shares = target

        q = pos["qty"]
        liab = q * MULT * straddle_price(S, pos["K"], T, RATE, iv_t)
        pv = 0.0
        if pos["Kp"] is not None:
            pv = q * MULT * bs_put(S, pos["Kp"], T, RATE, vol_at(S, pos["Kp"], iv_t, slope_t))
        eq_rows.append({"date": today, "equity": cash + shares * S - liab + pv})
    return (pd.DataFrame(trade_rows),
            pd.DataFrame(eq_rows).set_index("date")["equity"])

def label(p): return "unhedged" if p is None else f"put@{int(p*100)} (skewed)"
R = {}
for p in CASES:
    trades, eq = run(df, p)
    trades.to_csv(f"step2_trades_{label(p).replace(' ', '')}.csv", index=False)
    R[label(p)] = (trades, eq)
    print(f"Ran: {label(p)}")

# ---- stats + ratios ----------------------------------------------------
def ratios(t, e):
    pnl = t["trade_pnl"]
    years = (e.index[-1] - e.index[0]).days / 365.25
    ann_pnl = e.iloc[-1] / years
    maxdd = (e - e.cummax()).min()
    losers = pnl[pnl < 0]
    sharpe  = pnl.mean() / pnl.std() * np.sqrt(12) if pnl.std() > 0 else np.nan
    sortino = pnl.mean() / losers.std() * np.sqrt(12) if len(losers) > 1 else np.nan
    calmar  = ann_pnl / abs(maxdd) if maxdd < 0 else np.nan
    return sharpe, sortino, calmar, ann_pnl, maxdd

names = list(R)
print("\n===== STEP 2: $1,000/MONTH, 0.1bp HEDGE COSTS, REAL SKEW ON PUTS =====")
print(f"{'':26s}" + "".join(f"{n:>18s}" for n in names))
def rowp(lbl, fn, fmt="{:>18,.0f}"):
    print(f"{lbl:26s}" + "".join(fmt.format(fn(*R[n])) for n in names))
rowp("Completed trades",     lambda t, e: len(t))
rowp("Total P&L ($)",        lambda t, e: e.iloc[-1])
rowp("Avg trade P&L ($)",    lambda t, e: t["trade_pnl"].mean())
rowp("Avg put cost ($/mo)",  lambda t, e: t["put_cost"].mean())
rowp("Total put spend ($)",  lambda t, e: t["put_cost"].sum())
rowp("Total hedge costs ($)",lambda t, e: t["hedge_costs"].sum())
rowp("Win rate",             lambda t, e: (t["trade_pnl"] > 0).mean(), "{:>18.1%}")
rowp("Worst trade ($)",      lambda t, e: t["trade_pnl"].min())
rowp("Max drawdown ($)",     lambda t, e: (e - e.cummax()).min())
rowp("Months put paid off",  lambda t, e: (t["put_payout"] > 0).sum())
rowp("Sharpe (ann.)",        lambda t, e: ratios(t, e)[0], "{:>18.2f}")
rowp("Sortino (ann.)",       lambda t, e: ratios(t, e)[1], "{:>18.2f}")
rowp("Calmar",               lambda t, e: ratios(t, e)[2], "{:>18.2f}")

# ======================================================================
# CHART 1 — THE MONTHLY INSURANCE BILL (both hedges) + CUMULATIVE
# ======================================================================
t85, _ = R["put@85 (skewed)"]; t90, _ = R["put@90 (skewed)"]
fig, (a1, a2) = plt.subplots(2, 1, figsize=(10.5, 6.4), sharex=True)
a1.plot(t90["entry_date"], t90["put_cost"], color=VIOLET, lw=1.3,
        label="90% put — monthly cost at real skewed vol")
a1.plot(t85["entry_date"], t85["put_cost"], color=BLUE, lw=1.3,
        label="85% put — monthly cost at real skewed vol")
a1.fill_between(t90["entry_date"], t85["put_cost"], t90["put_cost"],
                where=t90["put_cost"] >= t85["put_cost"], color=VIOLET, alpha=0.10, lw=0)
a1.set_title("The monthly insurance bill (\\$ per month, per \\$1,000 of premium sold) — "
             "unhedged pays zero by definition", fontsize=11.5, loc="left", color=INK)
a1.legend(frameon=False, fontsize=9.5)
a2.plot(t90["entry_date"], t90["put_cost"].cumsum(), color=VIOLET, lw=1.6,
        label=f"90% put — total ${t90['put_cost'].sum():,.0f}")
a2.plot(t85["entry_date"], t85["put_cost"].cumsum(), color=BLUE, lw=1.6,
        label=f"85% put — total ${t85['put_cost'].sum():,.0f}")
a2.set_title("Cumulative insurance spend (\\$)", fontsize=10.5, loc="left", color=INK)
a2.legend(frameon=False, fontsize=9.5, loc="upper left")
for a in (a1, a2): style(a)
fig.tight_layout()
fig.savefig("step2_insurance.png", dpi=170)
print("\nsaved step2_insurance.png")

# ======================================================================
# CHART 2 — CUMULATIVE P&L + DRAWDOWN, ALL THREE CASES
# ======================================================================
fig, (a1, a2) = plt.subplots(2, 1, figsize=(11, 7.5), sharex=True,
                             gridspec_kw={"height_ratios": [3, 1]})
for name, (_, eq) in R.items():
    a1.plot(eq.index, eq.values, lw=1.5, color=COLORS[name], label=name)
    dd = eq - eq.cummax()
    a2.plot(dd.index, dd.values, lw=1.0, color=COLORS[name])
a1.axhline(0, color="#999999", lw=0.7)
a1.set_title("Upgraded strategy — \\$1,000 premium/month, hedge costs, real skew on puts — "
             "cumulative P&L (\\$)", fontsize=11.5, loc="left", color=INK)
a1.legend(frameon=False, fontsize=9.5)
a2.set_title("Drawdown from peak (\\$)", fontsize=10.5, loc="left", color=INK)
for a in (a1, a2): style(a)
fig.tight_layout()
fig.savefig("step2_equity.png", dpi=170)
print("saved step2_equity.png")
